---
import CassioAvatar from "@/components/ui/cassio-avatar.astro";
import Box from "@/components/box/index.astro";
import BoxContent from "@/components/box/content.astro";

import { PROFILE_INFO } from "@/lib/constants/profile";
import { Briefcase, Mail, Paperclip, MapPin } from "lucide-react";

import VerifiedIcon from "@/components/ui/icons/verified.astro";
import GithubIcon from "@/components/ui/icons/github.astro";
import LinkedinIcon from "@/components/ui/icons/linkedin.astro";

const links = [
  {
    label: "Resume",
    href: "https://drive.google.com/file/d/1RVc1kmLBCdCMJRmhOTmYdCT2HyWp5aNq/view?usp=sharing",
    icon: Paperclip,
  },
  { label: "Email", href: `mailto:${PROFILE_INFO.email}`, icon: Mail },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/alessio-cassieri/", icon: LinkedinIcon },
  { label: "GitHub", href: "https://github.com/Cassio7", icon: GithubIcon },
];
---

<div class="screen-line-after relative overflow-hidden p-4 pt-6 pb-8 md:border-x md:p-8 md:pt-12 md:pb-14">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 [background:radial-gradient(60%_80%_at_85%_0%,hsl(var(--primary)/0.07),transparent)]"
  >
  </div>

  <div class="relative flex flex-col gap-5 sm:flex-row sm:items-end sm:gap-8">
    <div class="reveal shrink-0" style="--i: 0">
      <CassioAvatar
        className="size-20 rounded-2xl ring-1 ring-border ring-offset-4 ring-offset-background sm:size-32"
        size={128}
        priority
      />
    </div>

    <div class="flex flex-1 flex-col gap-3">
      <p class="reveal line-clamp-1 font-mono text-xs text-muted-foreground" style="--i: 1">
        {PROFILE_INFO.slogan}
      </p>

      <h1
        class="reveal flex items-center gap-x-3 text-[2rem] leading-none font-extrabold tracking-tighter text-primary min-[400px]:text-4xl sm:text-6xl"
        style="--i: 2"
      >
        {PROFILE_INFO.displayName}
        <VerifiedIcon class="size-5 shrink-0 text-primary sm:size-6" />
      </h1>

      <div class="reveal flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm text-muted-foreground" style="--i: 3">
        <p class="w-full sm:w-auto">{PROFILE_INFO.role}</p>
        <p class="flex items-center gap-1.5">
          <Briefcase className="size-3.5" />
          <span>
            at{" "}
            <a
              href="https://gsa.eco/"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-sm font-medium text-primary underline underline-offset-4 transition-opacity hover:opacity-70"
            >
              GSA
            </a>
          </span>
        </p>
        <p class="flex items-center gap-1.5">
          <MapPin className="size-3.5" />
          {PROFILE_INFO.location}
        </p>
      </div>
    </div>
  </div>
</div>

<Box>
  <BoxContent className="md:px-8">
    <ul class="reveal grid grid-cols-2 gap-2 sm:flex sm:flex-wrap" style="--i: 4">
      {
        links.map(link => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 rounded-md border !border-solid px-3 py-2.5 text-sm font-medium text-primary transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary hover:text-primary-foreground active:translate-y-0 active:scale-[0.98]"
            >
              <link.icon className="size-4" />
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </BoxContent>
</Box>
