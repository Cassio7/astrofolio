---
import Badge from "@/components/ui/badge.astro";
import { markdownToHtml } from "@/lib/markdown";
import type { ExperiencePosition } from "@/lib/types";
import { ChevronDown, Code2 } from "lucide-react";

interface Props {
  position: ExperiencePosition;
}

const { position } = Astro.props;
---

<div>
  <div class="block w-full text-left">
    <div class="relative z-1 mb-2 flex items-center space-x-3">
      <Code2 className="size-4 bg-background" />
      <h3 class="text-base font-bold">
        {position.title}
      </h3>
    </div>
    <time class="flex items-center gap-2 pl-7 font-mono text-sm text-muted-foreground">
      {position.year}
    </time>
  </div>

  <div class="description-container mt-6">
    <div class="description-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out">
      <div class="overflow-hidden">
        <div class="description-body ml-7" set:html={markdownToHtml(position.description)} />

        {
          Array.isArray(position.skills) && position.skills.length > 0 && (
            <div class="mt-8 ml-7 flex max-w-full flex-wrap items-center justify-start gap-2">
              {position.skills.map(skill => {
                return <Badge>{skill}</Badge>;
              })}
            </div>
          )
        }
      </div>
    </div>

    <button
      type="button"
      aria-expanded="false"
      class="toggle-btn mt-8 ml-7 flex cursor-pointer items-center gap-1 rounded-md border !border-solid px-4 py-2 text-xs font-medium text-primary transition-all duration-200 hover:bg-secondary active:scale-[0.98]"
    >
      <span class="toggle-text">Show more</span>
      <ChevronDown className="toggle-icon size-4 transition-transform duration-300" />
    </button>
  </div>
</div>

<style>
  .description-body :global(ul) {
    display: grid;
    gap: 1rem;
  }

  .description-body :global(li) {
    position: relative;
    max-width: 68ch;
    padding-left: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.6rem;
    color: var(--color-muted-foreground);
    text-wrap: pretty;
  }

  .description-body :global(li)::before {
    content: "";
    position: absolute;
    top: 0.8rem;
    left: 0;
    width: 0.5rem;
    height: 1px;
    background: currentColor;
  }

  .description-body :global(strong) {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .description-content.expanded {
    grid-template-rows: 1fr;
  }

  .toggle-btn[aria-expanded="true"] :global(.toggle-icon) {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .description-content {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>(".toggle-btn").forEach((button, index) => {
      const content = button.closest(".description-container")?.querySelector(".description-content");
      const label = button.querySelector(".toggle-text");
      if (!content || !label) return;

      const setExpanded = (expanded: boolean) => {
        content.classList.toggle("expanded", expanded);
        button.setAttribute("aria-expanded", String(expanded));
        label.textContent = expanded ? "Show less" : "Show more";
      };

      // The most recent position starts open
      setExpanded(index === 0);
      button.addEventListener("click", () => setExpanded(!content.classList.contains("expanded")));
    });
  });
</script>
